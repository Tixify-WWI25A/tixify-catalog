# Kopieren nach .env (wird nicht eingecheckt) und Werte eintragen.
# Auf Heroku: heroku config:set NAME=wert -a tixify-catalog

# Postgres (auf Heroku automatisch gesetzt, wenn die Datenbank von "tixify" geteilt wird)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tixify
REDIS_URL=redis://localhost:6379

# Muss in gateway, catalog und orders IDENTISCH sein, sonst werden Tokens abgelehnt
JWT_SECRET=tixify_super_secret_jwt_key_2026

# Gemeinsamer Schlüssel für Service-zu-Service-Aufrufe (catalog und orders identisch).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=9ea106d9548c9ff1a8a87fe880df219f66cb05948bad9c40c7d9fb38a248cb9c
CATALOG_URL=http://localhost:3001

# PayPal (Sandbox-App im PayPal-Developer-Dashboard)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=AVndjgaKBKMmUmG3ThQ4_rHDU7F6D3a5IHI7miAYj8lFKTzMyUkNSMpl60ew6UW5LRmD6yfsBivJZYSj
PAYPAL_CLIENT_SECRET=EE2VulLecNOqPJKrCXGxXDS4Fbb0Vf4Fjv00yO4s1s8zd_8hvyB3ymEn1-nHjyDu4xkhmBGzDklGaaqS

# Höchstens so viele Tickets pro Event und Kunde (Standard 5)
MAX_TICKETS_PER_EVENT=5

# Optional
PORT=3002
RESERVATION_TTL_MINUTES=15
NOMINATIM_CONTACT=tixify.project@gmail.com

